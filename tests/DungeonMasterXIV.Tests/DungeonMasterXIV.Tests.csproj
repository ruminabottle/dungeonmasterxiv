<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Dalamud persists config with Newtonsoft, so the round-trip test uses the same serializer.
         Referenced as a package rather than from the Dalamud folder: nothing under Dalamud may
         enter this assembly's reference graph. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    Core ONLY. This project must never reference DungeonMasterXIV.csproj.

    Dalamud must never reach this assembly's reference graph. Today it cannot, but only by
    accident: raw <Reference> items do not flow transitively through a ProjectReference, and the
    plugin's Dalamud references are Private=false. Switching to a Dalamud PackageReference, or
    flipping Private, would make Dalamud flow here transitively. Referencing Core and nothing else
    makes the guarantee deliberate instead of incidental.

    Observed 2026-08-26: a Dalamud-touching test on main fails loudly at runtime with
    FileNotFoundException, contained to that test. The whole-assembly silent skip described
    elsewhere was not reproducible on this configuration, though it would become reachable if
    Dalamud ever flows here transitively.

    Either way: anything needing a Dalamud type is not unit-testable on this machine and must be
    kept thin enough not to need it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DungeonMasterXIV.Core\DungeonMasterXIV.Core.csproj" />
  </ItemGroup>

</Project>
