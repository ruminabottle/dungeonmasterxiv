<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Dalamud persists config with Newtonsoft, so the round-trip test uses the same serializer.
         Referenced as a package rather than from the Dalamud folder: nothing under Dalamud may
         enter this assembly's reference graph. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    Core ONLY. This project must never reference DungeonMasterXIV.csproj.

    That reference is what used to put Dalamud in this assembly's reference graph. Dalamud.dll
    needs Microsoft.WindowsDesktop.App, which has no macOS build, so a single test touching a
    Dalamud type made xUnit skip the WHOLE assembly while `dotnet test` still exited 0 — every
    other test silently stopped running behind a green summary.

    With only Core referenced, writing such a test is a compile error instead. Anything that needs
    a Dalamud type is not unit-testable on this machine and must be kept thin enough not to need it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DungeonMasterXIV.Core\DungeonMasterXIV.Core.csproj" />
  </ItemGroup>

</Project>
