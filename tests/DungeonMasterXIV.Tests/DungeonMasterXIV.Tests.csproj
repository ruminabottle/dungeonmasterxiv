<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Dalamud persists config with Newtonsoft, so the round-trip test uses the same serializer.
         Referenced as a package rather than from the Dalamud folder: nothing under Dalamud may
         enter this assembly's reference graph. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Dalamud.dll requires Microsoft.WindowsDesktop.App, which does not exist on macOS. If any
       Dalamud type reaches this assembly's reference graph the whole test assembly is skipped and
       `dotnet test` still exits 0. So this project touches only the Dalamud-free types:
       Data/PluginSettings.cs and Services/CommandDispatcher.cs. -->
  <ItemGroup>
    <ProjectReference Include="..\..\DungeonMasterXIV.csproj" />
  </ItemGroup>

</Project>
