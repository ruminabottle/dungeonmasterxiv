<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets net10.0, with package versions pinned to match DungeonMasterXIV.Tests so restore reuses the local cache. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Brings in the ASP.NET Core shared framework so WebApplication and HttpContext resolve; a ProjectReference alone doesn't add it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DungeonMasterXIV.Relay\DungeonMasterXIV.Relay.csproj" />
  </ItemGroup>

</Project>
