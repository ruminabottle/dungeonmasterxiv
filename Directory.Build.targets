<Project>

  <!--
    TLS fence: any project other than the allowlisted one fails the build if its code names a
    certificate-validation callback. It matches names textually; a positional or indirect callback is not caught.
  -->

  <PropertyGroup>
    <!-- The one project permitted to disable certificate validation. -->
    <TlsValidationBypassPermittedIn>DungeonMasterXIV.Relay.Tests</TlsValidationBypassPermittedIn>
  </PropertyGroup>

  <!-- Removes comments but keeps literals: the four literal forms are captured and restored by '$1$2$3$4'. -->
  <PropertyGroup>
    <TlsFenceCommentPattern>("""[\s\S]*?""")|(@"(?:[^"]|"")*")|("(?:\\.|[^"\\])*")|('(?:\\.|[^'\\])*')|/\*[\s\S]*?\*/|//[^\r\n]*</TlsFenceCommentPattern>
  </PropertyGroup>

  <Target Name="NoTlsValidationBypass"
          BeforeTargets="Build"
          Outputs="%(Compile.Identity)"
          Condition="'$(MSBuildProjectName)' != '$(TlsValidationBypassPermittedIn)'">

    <!-- One batch per source file. -->
    <ItemGroup>
      <_ScannedSourceLine Remove="@(_ScannedSourceLine)" />
    </ItemGroup>

    <!-- The file's text without comments. Literals are kept, so a callback name inside a string also fails. -->
    <PropertyGroup>
      <_CodeOutsideComments>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), '$(TlsFenceCommentPattern)', '$1$2$3$4'))</_CodeOutsideComments>
    </PropertyGroup>

    <!-- Names assigned a callback to stop validation. None may be a substring of a hardening name (e.g. CheckCertificateRevocationList). -->
    <ReadLinesFromFile File="%(Compile.FullPath)" Condition="$(_CodeOutsideComments.Contains('RemoteCertificateValidationCallback'))
                                                          Or $(_CodeOutsideComments.Contains('ServerCertificateCustomValidationCallback'))
                                                          Or $(_CodeOutsideComments.Contains('ServerCertificateValidationCallback'))
                                                          Or $(_CodeOutsideComments.Contains('userCertificateValidationCallback'))
                                                          Or $(_CodeOutsideComments.Contains('DangerousAccept'))">
      <Output TaskParameter="Lines" ItemName="_ScannedSourceLine" />
    </ReadLinesFromFile>

    <!-- Picks the offending line to quote; the decision was made above. -->
    <Error Condition="!$([System.String]::Copy('%(_ScannedSourceLine.Identity)').TrimStart().StartsWith('//'))
                  And !$([System.String]::Copy('%(_ScannedSourceLine.Identity)').TrimStart().StartsWith('/*'))
                  And !$([System.String]::Copy('%(_ScannedSourceLine.Identity)').TrimStart().StartsWith('* '))
                  And ($([System.String]::Copy('%(_ScannedSourceLine.Identity)').Contains('RemoteCertificateValidationCallback'))
                    Or $([System.String]::Copy('%(_ScannedSourceLine.Identity)').Contains('ServerCertificateCustomValidationCallback'))
                    Or $([System.String]::Copy('%(_ScannedSourceLine.Identity)').Contains('ServerCertificateValidationCallback'))
                    Or $([System.String]::Copy('%(_ScannedSourceLine.Identity)').Contains('userCertificateValidationCallback'))
                    Or $([System.String]::Copy('%(_ScannedSourceLine.Identity)').Contains('DangerousAccept')))"
           Text="$(MSBuildProjectName) disables TLS certificate validation in %(Compile.Identity): &quot;%(_ScannedSourceLine.Identity)&quot;. A client that accepts any certificate has no transport authentication and still looks protected. Only $(TlsValidationBypassPermittedIn) may do this." />

  </Target>

</Project>
