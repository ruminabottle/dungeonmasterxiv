<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DungeonMasterXIV</AssemblyName>
    <RootNamespace>DungeonMasterXIV</RootNamespace>
    <!-- The version is authored only by the release tag: dotnet build -c Release -p:ReleaseTag=v1.2.3. -->
    <!-- ReleaseTagVersion is the tag with leading 'v's trimmed; untagged builds fall back to 0.0.0.0, never released.
         Kept separate from Version so a bare 'v' leaves it empty and fails the shape check instead of building as 0.0.0.0. -->
    <ReleaseTagVersion Condition="'$(ReleaseTag)' != ''">$(ReleaseTag.TrimStart('v'))</ReleaseTagVersion>

    <Version Condition="'$(ReleaseTagVersion)' != ''">$(ReleaseTagVersion)</Version>
    <Version Condition="'$(Version)' == ''">0.0.0.0</Version>
    <Description>Tracks dice rolls, initiative, HP and session state for tabletop RP campaigns run in FFXIV.</Description>
    <PackageProjectUrl>https://github.com/ruminabottle/dungeonmasterxiv</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Refuses a malformed tag before NuGet restore, which would otherwise fail with an unexplained MSB4181. -->
  <Target Name="ReleaseTagIsSpeltForTheBuild" BeforeTargets="Restore;CollectPackageReferences;PrepareForBuild"
          Condition="'$(ReleaseTag)' != ''">
    <Error Condition="!$(ReleaseTag.StartsWith('v'))"
           Text="ReleaseTag '$(ReleaseTag)' must begin with a lowercase 'v', e.g. v0.1.0. The tag is the one place the advertised version is authored, and the release tool refuses any other spelling of it." />

    <!-- The tag must leave a version shape: one to four components of at most five digits each,
         optionally with a prerelease suffix. -->
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ReleaseTagVersion)', '^[0-9]{1,5}(\.[0-9]{1,5}){0,3}(-[0-9A-Za-z.-]+)?$'))"
           Text="ReleaseTag '$(ReleaseTag)' is not a shape this build can turn into a version: it leaves '$(ReleaseTagVersion)', and a version is one to four dot-separated numbers of at most five digits each, e.g. v0.1.0 or v1.2.3.4. Retag with that shape." />

  </Target>

  <!-- Assembly-version components cap at 65534; refuse a larger one here instead of as CS7034 in generated code.
       Its own conditioned target: an Error batched over an empty item list still runs once, and Int64.Parse('') would crash. -->
  <Target Name="ReleaseTagFitsAnAssemblyVersion" BeforeTargets="Restore;CollectPackageReferences;PrepareForBuild"
          Condition="'$(ReleaseTag)' != '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(ReleaseTagVersion)', '^[0-9]{1,5}(\.[0-9]{1,5}){0,3}$'))">
    <ItemGroup>
      <ReleaseTagComponent Include="$(ReleaseTagVersion.Split('.'))" />
    </ItemGroup>

    <Error Condition="$([System.Int64]::Parse('%(ReleaseTagComponent.Identity)')) &gt; 65534"
           Text="ReleaseTag '$(ReleaseTag)' has the component %(ReleaseTagComponent.Identity), and an assembly version component cannot exceed 65534. Pick a version whose parts are all 65534 or below." />
  </Target>

  <!-- Excludes the nested src/ and tests/ project sources from this project's default compile glob. -->
  <ItemGroup>
    <Compile Remove="src/**" />
    <None Remove="src/**" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <!-- Excludes the release tooling under tools/, including its obj/ output, from this project's default compile glob. -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <!-- References the Dalamud-free half of the plugin. -->
  <ItemGroup>
    <ProjectReference Include="src/DungeonMasterXIV.Core/DungeonMasterXIV.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DalamudPackager" Version="15.0.0" />
  </ItemGroup>

  <!-- Supplied by the Dalamud host at runtime; never copied into the plugin output. -->
  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
